# Copy this file to .env and fill in your own values. Never commit .env.
# Empty key: the app runs on the offline matcher and says so on the start page.
GEMINI_API_KEY=

# Optional. Default: gemini-3.8-flash. Checked against Google's model list at start.
GEMINI_MODEL=

# Optional, at least 10 characters. Empty: a random password is printed at start.
BOTHSIDES_STAFF_PASSWORD=

# Optional. Extra host names for the Host check, separated by commas.
BOTHSIDES_ALLOWED_HOSTS=
