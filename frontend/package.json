{
  "name": "both-sides-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config landing/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p landing",
    "build": "npm run typecheck && vite build && vite build --config landing/vite.config.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
